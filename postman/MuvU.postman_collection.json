              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direccion\": \"Av. Pedro de Osma 120, Barranco, Lima\",\n  \"precio\": 850.0,\n  \"area\": 18\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
