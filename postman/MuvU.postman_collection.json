          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar arrendador sin token (401/403)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/arrendador/{{arrendadorId}}/verificar",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Rechazado\", () => pm.expect(pm.response.code).to.be.oneOf([401,403]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin verifica al arrendador",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/arrendador/{{arrendadorId}}/verificar",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Verificado\", () => pm.expect(pm.response.json().verificado).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar datos del arrendador",
          "request": {
            "method": "PUT",
            "header": [
