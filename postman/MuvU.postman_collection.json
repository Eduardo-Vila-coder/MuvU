              "raw": "{\n  \"nombre\": \"Rosa Quispe\",\n  \"correo\": \"{{correoRosa}}\",\n  \"contrasena\": \"Clave123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"correoRosa\", \"rosa\" + Date.now() + \"@gmail.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"tokenArrendador\", pm.response.json().token);",
                  "pm.collectionVariables.set(\"arrendadorId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear habitación sin estar verificado (403)",
          "request": {
            "method": "POST",
