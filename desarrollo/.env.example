# Copia este archivo como .env (en MuvU/desarrollo) y completa tus valores.
# El .env NO se sube a GitHub (está en .gitignore).

# ===== Servidor (opcional, por defecto 8081) =====
# PORT=8081

# ===== Base de datos =====
# Local: no hace falta, se usa el Docker de docker-compose (localhost:5433, postgres/postgres)
# Producción (AWS RDS): jdbc:postgresql://<endpoint-rds>:5432/Muvu
# DB_URL=jdbc:postgresql://localhost:5433/Muvu
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# ===== APIs externas =====
STRIPE_SECRET_KEY=tu_clave_de_prueba_de_stripe
GOOGLE_MAPS_API_KEY=tu_clave_de_google_maps

# ===== JWT (el secreto debe tener mínimo 32 caracteres) =====
JWT_SECRET=pon-aqui-un-texto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
JWT_RESET_EXPIRATION=900000

# ===== CORS (opcional): frontends permitidos, separados por coma =====
# Por defecto: http://localhost:3000,http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== Correo (Gmail + contraseña de aplicación) =====
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion
